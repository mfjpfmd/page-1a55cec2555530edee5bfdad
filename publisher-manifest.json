round .18s ease,color .18s ease}\n.anchors a:hover,.anchors a:focus{background:var(--moss);color:var(--cream)}\n\n/* 通用区块 */\nsection{padding:64px 0}\nsection + section{border-top:1px solid var(--line)}\n.sec-head{max-width:44em;margin-bottom:34px}\n.sec-head .num{font-size:13px;letter-spacing:.2em;color:var(--clay);font-weight:700;display:block;margin-bottom:10px}\n.sec-head h2{font-size:clamp(24px,3.2vw,34px);color:var(--moss)}\n.sec-head p{margin-top:12px;color:var(--ink-soft);font-size:16px}\n\n/* 大圆角软阴影卡片 */\n.card{background:#fffdf4;border-radius:26px;padding:30px 30px;box-shadow:0 18px 40px -24px rgba(31,77,56,.45), 0 4px 12px -6px rgba(31,77,56,.18)}\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n.steps .card h3{font-size:19px;color:var(--moss);margin-bottom:10px}\n.steps .card .idx{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.14em;color:var(--clay);margin-bottom:12px}\n.steps .card p{font-size:15px;color:var(--ink-soft)}\n\n/* 套餐：两栏对照 + 推荐标记 */\n.plans{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:start}\n.plan{position:relative;background:#fffdf4;border-radius:26px;padding:30px 30px 28px;box-shadow:0 18px 40px -24px rgba(31,77,56,.45), 0 4px 12px -6px rgba(31,77,56,.18)}\n.plan.featured{background:var(--moss);color:var(--cream);box-shadow:0 26px 54px -26px rgba(29,58,44,.7)}\n.plan.featured h3,.plan.featured .price{color:#fff}\n.badge{position:absolute;top:-13px;right:26px;background:var(--clay);color:#fff;font-size:12px;font-weight:700;letter-spacing:.12em;padding:6px 14px;border-radius:999px}\n.plan h3{font-size:22px;color:var(--moss);margin-bottom:6px}\n.plan .price{font-size:clamp(28px,3.6vw,36px);font-weight:800;color:var(--moss);letter-spacing:-.02em}\n.plan .annual{font-size:14px;color:var(--ink-soft);margin-top:2px}\n.plan.featured .annual{color:var(--mint)}\n.plan ul{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:10px}\n.plan li{position:relative;padding-left:22px;font-size:15px}\n.plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:9px;height:9px;border:2px solid var(--clay);border-radius:50%}\n.plan.featured li::before{border-color:var(--cream)}\n.team-strip{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:26px}\n.team-strip .plan{background:var(--mint);box-shadow:0 10px 26px -20px rgba(31,77,56,.5)}\n.plan-foot{margin-top:26px;font-size:14px;color:var(--ink-soft);padding-top:18px;border-top:1px dashed var(--line)}\n.plan.featured .plan-foot{color:var(--mint);border-top-color:rgba(246,236,203,.3)}\n\n/* 客户端 */\n.client-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n.client-grid .card h3{font-size:18px;color:var(--moss);margin-bottom:8px}\n.client-grid .card p{font-size:15px;color:var(--ink-soft)}\n.client-grid .card .tag{display:inline-block;font-size:12px;letter-spacing:.14em;color:var(--clay);font-weight:700;margin-bottom:10px}\n.inline-link{display:inline-block;margin-top:12px;font-size:14px;font-weight:600;color:var(--moss);text-decoration:none;border-bottom:2px solid var(--clay);padding-bottom:1px}\n.inline-link:hover{color:var(--clay)}\n\n/* FAQ 对话气泡 */\n.faq-list{display:grid;gap:24px;max-width:820px}\n.qa{display:grid;grid-template-columns:auto 1fr;gap:14px}\n.qa .who{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;letter-spacing:.06em;background:var(--moss);color:var(--cream)}\n.bubble{background:#fffdf4;border-radius:22px 22px 22px 8px;padding:22px 24px;box-shadow:0 14px 30px -24px rgba(31,77,56,.5)}\n.bubble h3{font-size:17px;color:var(--moss);margin-bottom:8px}\n.bubble p{font-size:15px;color:var(--ink-soft)}\n.qa.answer{grid-template-columns:1fr auto}\n.qa.answer .who{background:var(--clay);color:#fff;order:2}\n.qa.answer .bubble{background:var(--cream-deep);border-radius:22px 22px 8px 22px;box-shadow:none}\n.qa.answer .bubble p{color:var(--ink)}\n\n/* 结尾说明 */\n.foot{padding:56px 0 72px;border-top:1px solid var(--line)}\n.foot h2{font-size:clamp(22px,2.8vw,28px);color:var(--moss);margin-bottom:14px}\n.foot p{max-width:42em;color:var(--ink-soft);font-size:15px}\n.foot .meta{margin-top:30px;font-size:13px;color:var(--ink-soft);opacity:.8;display:flex;flex-wrap:wrap;gap:8px 26px}\n\n@media (max-width:860px){\n  .mag{grid-template-columns:1fr;gap:28px}\n  .steps,.client-grid{grid-template-columns:1fr}\n  .plans,.team-strip{grid-template-columns:1fr}\n  section{padding:48px 0}\n  .card,.plan{padding:24px 22px}\n  .qa{grid-template-columns:36px 1fr;gap:10px}\n  .qa.answer{grid-template-columns:1fr 36px}\n  .qa .who{width:36px;height:36px;border-radius:12px;font-size:12px}\n}\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"kicker\">\n        <span class=\"dot\"></span>\n        <span>alaala</span>\n        <span>网络访问方案</span>\n        <span>按月 / 按年</span>\n      </div>\n\n      <div class=\"mag\">\n        <div>\n          <h1>alaala<span>把网络访问说明白</span></h1>\n          <p class=\"lede\">三个档位。按流量和在线设备数区分。价格写在明面上，权限列在同一页。先看清，再决定。</p>\n          <p class=\"pull\">选套餐只看两件事：你每月用多少流量，同时有几台设备在线。</p>\n        </div>\n        <aside class=\"side-rule\">\n          <h2>这一页有什么</h2>\n          <p>使用步骤、三档套餐的逐项权益、客户端说明，以及常见问题。没有多余的话。</p>\n          <p class=\"side-note\">所有价格为一个订阅周期的费用。按年付一次性支付，折算到月的数字会低一些。</p>\n        </aside>\n      </div>\n\n      <nav class=\"anchors\" aria-label=\"页面内跳转\">\n        <a href=\"#how\">使用步骤</a>\n        <a href=\"#plans\">套餐对照</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01 / 开始之前</span>\n        <h2>三步走完，不用研究文档</h2>\n        <p>订阅、登录、选择线路。每一步只做一件事。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"card\">\n          <span class=\"idx\">第一步</span>\n          <h3>确定你的用量</h3>\n          <p>翻一下上个月的记录：看视频多，流量消耗就快。办公、查资料、传输文档，通常落在基础档的区间里。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"idx\">第二步</span>\n          <h3>选周期并订阅</h3>\n          <p>月付适合先试一段时间。确定长期使用就换按年付，同样的权益，全年一次性结算，单价更低。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"idx\">第三步</span>\n          <h3>登录并连上</h3>\n          <p>在客户端里填入账号信息，选择离你较近的线路。切换线路不需要重新订阅，在客户端内直接改。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02 / 套餐对照</span>\n        <h2>三档，两两对照看</h2>\n        <p>左侧是基础档，右侧是旗舰档。团队档单列在下方，单独说明。</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15<span> / 月</span></div>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-foot\">适合个人日常使用：浏览、社交、少量视频。</p>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"badge\">推荐</span>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35<span> / 月</span></div>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-foot\">流量、设备数、线路质量三项同时上调，多数人会停在这一档。</p>\n        </article>\n      </div>\n\n      <div class=\"team-strip\">\n        <article class=\"plan\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85<span> / 月</span></div>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-foot\">按团队规模与办公需要配置，路由方案在订阅后与客户经理确认。</p>\n        </article>\n        <article class=\"card\">\n          <h3>怎么选，一条建议</h3>\n          <p>个人一台电脑加一部手机，基础版够。手机、平板、电脑同时在用，且常看视频，选旗舰版。需要给多人分配权限，看团队版。</p>\n          <p>不确定就先月付。用完一个周期再比较用量，比提前猜准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03 / 客户端</span>\n        <h2>在你常用的设备上用</h2>\n        <p>账号通用。客户端按设备类型分开说明，安装包与地址请以订阅后页面的说明为准。</p>\n      </div>\n      <div class=\"client-grid\">\n        <article class=\"card\">\n          <span class=\"tag\">桌面端</span>\n          <h3>Windows 与 macOS</h3>\n          <p>安装后登录账号，线路列表自动加载。建议把常用线路固定在列表顶部，切换更快。</p>\n          <a class=\"inline-link\" href=\"#faq\">查看常见问题</a>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">移动端</span>\n          <h3>iOS 与 Android</h3>\n          <p>移动端按系统提供的网络配置方式接入。首次连接需在系统设置中确认一次授权。</p>\n          <a class=\"inline-link\" href=\"#faq\">查看连接说明</a>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">多设备</span>\n          <h3>同时在线数量</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。超出数量时，先下线一台再用新的。</p>\n          <a class=\"inline-link\" href=\"#plans\">回到套餐对照</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04 / 常见问题</span>\n        <h2>问得最多的几个</h2>\n        <p>下面是订阅前后最常被问到的内容。如果你的问题不在这，请通过订阅后页面提供的方式联系我们。</p>\n      </div>\n\n      <div class=\"faq-list\">\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>流量用不完会结转到下个月吗？</h3>\n            <p>不会。每个订阅周期开始时重置，按当前套餐额度重新计算。如果你发现连续几个月都用不完，降一档更划算。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>按周期重置，不累计、不结转。套餐可以调整，从下个周期开始生效。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>月付和按年付有什么区别？</h3>\n            <p>权益相同，结算方式不同。按年付一次性支付全年费用，折算到月的单价更低。基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>区别只在结算周期和价格。功能、设备数、线路权限完全一致，不因付年付而额外增加或减少。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>设备数超了会怎样？</h3>\n            <p>同一时间在线的设备数不能超过套餐上限。超出时新设备无法建立连接，先在其他设备上退出即可。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>数量按同时在线的设备计算，不看累计登录过的设备。常用设备多，直接选旗舰版或团队版。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>换了电脑，需要重新订阅吗？</h3>\n            <p>不需要。账号不变就能在新设备上登录，只要在线设备总数没超过上限。旧设备退出后名额即释放。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>订阅跟着账号走，不绑定硬件。登录、退出都在客户端内完成。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>团队版的企业定制路由怎么开？</h3>\n            <p>订阅团队版之后，由专属客户经理对接，确认办公场景与设备分布，再给出路由配置建议。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>定制路由与 VIP 专属节点都需要在订阅后确认具体配置，页面上不预先承诺参数。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>客户端从哪里获取？</h3>\n            <p>这里不提供安装包直链。订阅完成后，在账号页面会看到对应平台的获取方式与版本说明。</p>\n          </div>\n        </div>\n\n        <div class=\"qa answer\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>请只从账号页面给出的渠道获取客户端，避免使用第三方来源的安装文件。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"foot\">\n    <div class=\"wrap\">\n      <h2>订之前，先把这几句看完</h2>\n      <p>alaala 的方案按流量与设备数分档，价格与权益如上。订阅周期内可调整档位，从下一个周期开始生效。企业定制路由、VIP 专属节点等配置在订阅后确认，本页不承诺具体技术参数。</p>\n      <div class=\"meta\">\n        <span>alaala</span>\n        <span>基础版 ¥15/月 · ¥150/年</span>\n        <span>旗舰版 ¥35/月 · ¥350/年</span>\n        <span>团队版 ¥85/月 · ¥850/年</span>\n      </div>\n    </div>\n  </section>\n\n</main>",
